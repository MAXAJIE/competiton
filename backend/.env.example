# CashMonitoring backend — copy to backend/.env and fill in.
# Load it with: .venv/Scripts/python -m dotenv run -- uvicorn app.main:app ...
# or set the variables however you prefer (python-dotenv is not required by the app).

# --- Supabase (Project Settings → API) --------------------------------------
# anon/public key: used for the login proxy and token validation
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_role key: server-side reads/writes, always filtered by user_id.
# NEVER expose this to the browser or commit it.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- OpenRouter (https://openrouter.ai/keys) ---------------------------------
# Without a key the advisor still answers via the same four tools
# deterministically (no LLM), but OCR is unavailable.
OPENROUTER_API_KEY=sk-or-v1-...

# Pinned model IDs (SKILL.md §1). The OCR model MUST accept image input, and
# free (:free) models rate-limit constantly (HTTP 429) — keep a paid primary
# plus a comma-separated fallback chain so a scan never dies on one provider.
OCR_MODEL=openai/gpt-4o-mini
OCR_FALLBACK_MODELS=google/gemini-2.5-flash,google/gemini-2.5-flash-lite

ADVISOR_MODEL=google/gemini-2.5-flash
ADVISOR_FALLBACK_MODELS=openai/gpt-4o-mini,nvidia/nemotron-3.5-lightning:free

# --- Email (Resend, https://resend.com) --------------------------------------
# "Send test report now" fails loudly with 503 until this is set — its
# output is never faked (SKILL.md §7). EMAIL_FROM must be a verified sender.
RESEND_API_KEY=re_...
EMAIL_FROM=CashMonitoring <reports@resend.dev>

# --- Demo seed (python -m app.demo_seed) -------------------------------------
DEMO_EMAIL=demo@veritas.hackathon
DEMO_PASSWORD=change-me-before-demo
DEMO_REPORT_EMAIL=owner@example.com
