# CashMonitoring frontend — copy to .env.local and fill in.
# (Vite only exposes variables prefixed with VITE_ to the browser; these are
# public-by-design values — the anon key is safe client-side, per Supabase.)

# Supabase project (Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Python backend (backend/README.md)
VITE_API_URL=http://localhost:8000
